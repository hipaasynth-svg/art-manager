# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Required to run the agent (the LLM client is built lazily on first use).
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults preserve current behaviour) ---
# LLM model id
# ART_MANAGER_MODEL=claude-opus-4-8

# Site ownership (site changes ship only via PR)
# ART_MANAGER_GITHUB_OWNER=hipaasynth-svg
# ART_MANAGER_GITHUB_REPO=codycarlson.art
# ART_MANAGER_DEFAULT_BRANCH=main

# Google Drive folder IDs
# ART_MANAGER_DRIVE_ROOT_ID=1uzI3VXasnvl-4_KemHN60dgwBP1_q4vr
# ART_MANAGER_DRIVE_PRINTOUTS_ID=1WUh8YNYO7736eUwhU0EctoM9wZWOHARM
# ART_MANAGER_DRIVE_BRIEFS_ID=1s3nujmMevAOGWvfCk-dwZf5l0SVuS2HB
# ART_MANAGER_DRIVE_BUYERS_ID=103wQVeWOo-gVdeglZD_w7jwNbGsdnXJZ
# ART_MANAGER_DRIVE_STATE_ID=1shpW9nOsr6EOHNblz23NUiZWIUucrlV4

# Local state persistence
