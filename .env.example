# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Required to run the agent (the LLM client is built lazily on first use).
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults preserve current behaviour) ---
# LLM model id
# ART_MANAGER_MODEL=claude-opus-4-8

# The live site the agent reads to ground its analysis
# ART_MANAGER_SITE_URL=https://codycarlson.art

# Site ownership (site changes ship only via PR)
# ART_MANAGER_GITHUB_OWNER=hipaasynth-svg
# ART_MANAGER_GITHUB_REPO=codycarlson.art
# ART_MANAGER_DEFAULT_BRANCH=main

# --- Selling & buyer-finding hookups (see README "Hook it up") ---
# Buyer search API key (Google Places API "New") — powers real ND buyer
# lookup via agents/search.py. Without it, buyer suggestions stay AI-guessed
# and unverified (agent.has_buyer_search is False).
# ART_MANAGER_SEARCH_API_KEY=
# Payments are per-piece: set each for-sale piece's buy_url to a Stripe Payment
# Link / Gumroad URL (no global key needed for that).

# --- Send approved outreach via Zoho Mail (agents/mail.py) ---
# The agent drafts outreach; a human approves it; then agent.send_outreach()
# sends it over Zoho SMTP. Use a Zoho APP PASSWORD, not the account login.
# ZOHO_MAIL_USER is the REAL mailbox you log into (an alias has no password of
# its own). To send AS a verified alias on that account, set ZOHO_MAIL_FROM —
# login stays the mailbox, the visible From becomes the alias.
# ZOHO_MAIL_USER=cody@hipaasynth.com
# ZOHO_MAIL_PASSWORD=
# ZOHO_MAIL_FROM=cody1@codycarlson.art
# Optional SMTP overrides (defaults shown):
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=465

# --- Google Drive state persistence (agents/drive.py; optional) ---
# Point at a service-account JSON with access to the Drive state folder (share
# the folder with the service account's email). Also needs the optional deps:
#   pip install -r requirements-drive.txt
# Without this, state persists to the local JSON file only.
# ART_MANAGER_DRIVE_CREDENTIALS=/path/to/service-account.json

# Google Drive folder IDs
# ART_MANAGER_DRIVE_ROOT_ID=1uzI3VXasnvl-4_KemHN60dgwBP1_q4vr
# ART_MANAGER_DRIVE_PRINTOUTS_ID=1WUh8YNYO7736eUwhU0EctoM9wZWOHARM
# ART_MANAGER_DRIVE_BRIEFS_ID=1s3nujmMevAOGWvfCk-dwZf5l0SVuS2HB
# ART_MANAGER_DRIVE_BUYERS_ID=103wQVeWOo-gVdeglZD_w7jwNbGsdnXJZ
# ART_MANAGER_DRIVE_STATE_ID=1shpW9nOsr6EOHNblz23NUiZWIUucrlV4

# Local state persistence
# ART_MANAGER_STATE_PATH=art_manager_state.json

# Business targets
# ART_MANAGER_MONTHLY_REVENUE_GOAL=2000
